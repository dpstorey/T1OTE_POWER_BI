# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- Tenable One OT Exposure / Enterprise Manager ---------------------------
# Base URL of the EM (no trailing path), e.g. https://em.example.com
TENABLE_URL=
# API key in the form: accessKey=XXXXXXXX;secretKey=YYYYYYYY
TENABLE_API_KEY=
# Optional: default site (paired ICP) machine id, used when --site-uuid /
# --site-name are not given. Run `python t1ote_export.py sites` to list them.
# If only one site is paired, it is used automatically.
TENABLE_SITE_UUID=
# TLS to the EM. Prefer a CA bundle for a private/internal CA:
TENABLE_CA_BUNDLE=
# ...or set to 0 to skip certificate verification (lab/POV use only):
TENABLE_TLS_VERIFY=1

# --- Microsoft Entra ID (Azure AD) app registration --------------------------
# Directory (tenant) ID and Application (client) ID of YOUR app registration.
# See README.md, "Create the Entra app registration".
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# --- Power BI ------------------------------------------------------------------
# Workspace (group) ID: the GUID in the workspace URL
#   https://app.powerbi.com/groups/<WORKSPACE_ID>/...
# Leave empty to use "My workspace".
POWERBI_WORKSPACE_ID=
# Filled in after running `create-dataset` (see README.md):
POWERBI_DATASET_ID=
# Only used by `create-dataset`:
POWERBI_DATASET_NAME=Tenable OT Asset Export
POWERBI_TABLE_NAME=assets

# Where the Power BI sign-in token is kept (a credential; gitignored).
TOKEN_CACHE_FILE=.powerbi_token.json
